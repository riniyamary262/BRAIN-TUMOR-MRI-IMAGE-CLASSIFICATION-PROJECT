if all(len(g) > 1 for g in height_groups):
    f_stat, p_val = stats.f_oneway(*height_groups)
    print(f"F-statistic: {f_stat:.4f}")
    print(f"P-value: {p_val:.4f}")
    if p_val < 0.05:
        print("Reject H0 -> Heights differ across classes.")
    else:
        print("Fail to reject H0 -> Heights are similar across classes.")
else:
    print("Not enough samples for ANOVA.")


