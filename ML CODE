# ============================================================
# HYPOTHESIS TEST 2 - ONE-WAY ANOVA ON IMAGE HEIGHT
# ============================================================

height_groups = []
for cls in classes:
    cls_path = os.path.join(IMAGE_ROOT, cls)
    vals = []
    for f in os.listdir(cls_path)[:50]:
