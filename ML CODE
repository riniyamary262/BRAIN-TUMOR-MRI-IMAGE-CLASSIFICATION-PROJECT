def find_image_root(dataset_path):
    """
    Detects the correct root folder for ImageDataGenerator.
    If dataset has train/test/valid subfolders, returns the train folder
    (since ImageDataGenerator with validation_split needs a single root).
    """
    subfolders = [f for f in os.listdir(dataset_path)
                  if os.path.isdir(os.path.join(dataset_path, f))]

    # Check if subfolders contain images directly (flat structure)
    def has_images(folder):
        for f in os.listdir(folder):
            if f.lower().endswith(('.png', '.jpg', '.jpeg')):
                return True
        return False

    # Case 1: Flat structure (class folders contain images directly)
    if any(has_images(os.path.join(dataset_path, f)) for f in subfolders):
        return dataset_path, 'flat'

    # Case 2: Nested structure (train/test/valid each with class folders)
    for split in ['train', 'Train', 'TRAIN']:
        candidate = os.path.join(dataset_path, split)
        if os.path.exists(candidate):
            return candidate, 'nested'

    # Case 3: Unknown — return root
    return dataset_path, 'unknown'


